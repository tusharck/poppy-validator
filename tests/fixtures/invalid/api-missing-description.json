{
  "protocol_version": "0.1",
  "organization": {
    "name": "Example Company",
    "domain": "example.com"
  },
  "auth": {
    "issuer": "https://auth.example.com",
    "direct": {
      "scopes": [
        "poppy:read",
        "poppy:write",
        "addresses"
      ]
    },
    "device": {
      "scopes": [
        "poppy:read",
        "poppy:write"
      ]
    },
    "mediated": {
      "endpoint": "https://auth.example.com/poppy/sign-in",
      "fields": [
        {
          "name": "email",
          "label": "Email",
          "secret": false
        },
        {
          "name": "password",
          "label": "Password",
          "secret": true
        }
      ],
      "scopes": [
        "poppy:read"
      ]
    },
    "custom_scopes": {
      "addresses": "Manage saved shipping addresses"
    }
  },
  "agent": {
    "protocols": [
      {
        "type": "poppy",
        "endpoint": "https://api.example.com/poppy/conversations"
      }
    ]
  },
  "web": {
    "browser_session_endpoint": "https://example.com/poppy/browser-session"
  },
  "apis": [
    {
      "type": "openapi",
      "url": "https://api.example.com/openapi.json",
      "description": "Orders, returns, and exchanges"
    },
    {
      "type": "mcp",
      "url": "https://mcp.example.com/mcp"
    }
  ]
}
